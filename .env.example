# 复制为 .env 并自行设置，不提交真实凭证。
DATABASE_URL=host=127.0.0.1 port=5432 user=engine dbname=autonomous_engine sslmode=disable
ENGINE_API_TOKEN=replace-with-a-random-token-at-least-32-characters
# REDIS_URL=redis://127.0.0.1:6379/0
ENGINE_MODE=dev
# Pi 使用 OpenAI 兼容 chat/completions；默认关闭，不会回退成演示结果。
# 先运行 make pi-install，再配置自己选定的模型提供方：
# PI_ENABLED=true
# PI_MODEL=your-model-id
# PI_BASE_URL=https://your-model-provider.example/v1
# PI_API_KEY=replace-with-your-model-key
# 仅授权本地靶场时设置，例如 PI_ALLOWED_CIDRS=127.0.0.1/32
# PI_CONCURRENCY=2
# PI_MAX_TURNS=8
# PI_MAX_TOOLS=8
# PI_MAX_TOKENS=16000
# PI_OUTPUT_TOKENS=2048
